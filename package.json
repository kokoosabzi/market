{
  "name": "market-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "نرم‌افزار فروشگاهی دسکتاپ محلی و فارسی",
  "main": "electron/main.cjs",
  "scripts": {
    "prestart": "npm run rebuild:native",
    "start": "electron .",
    "test": "node --test",
    "smoke:electron": "node scripts/electron-smoke.cjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dist:win": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ir.market.desktop",
    "productName": "Market",
    "asar": true,
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}